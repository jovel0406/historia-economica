---
import Base from "../../layouts/Base.astro";
import { aristasTodas, contenido, escuela, fuente } from "../../lib/contenido.ts";
import { ETIQUETA_ARISTA, ETIQUETA_CONSENSO, ETIQUETA_EVIDENCIA, ETIQUETA_PESO, periodoTexto, renderInline, renderMarkdown } from "../../lib/texto.ts";
export function getStaticPaths() {
  return aristasTodas().map((a) => ({ params: { id: a.id } }));
}
const { arista: a, declaradaEn } = aristasTodas().find((x) => x.id === Astro.params.id)!;
const desde = contenido().nodos.get(a.desde)!;
const hacia = contenido().nodos.get(a.hacia)!;
const nombre = (id: string) => escuela(id)?.nombre ?? id;
const escuelasImplicadas = [...new Set([...(a.sostenida_por ?? []), ...(a.negada_por ?? [])])];
const interpretacionesDe = (n: typeof desde, e: string) => n.interpretaciones.find((i) => i.escuela === e);
const seriesDe = (n: typeof desde) => n.series.map((s) => ({ ref: s, serie: contenido().series.get(s.serie) }));
const fuentes = a.fuentes.map((id) => fuente(id)).filter((f) => f !== undefined);
---
<Base titulo={`${desde.titulo} → ${hacia.titulo}`}>
  <p class="sobretitulo">Arista · declarada en <a href={`/nodos/${declaradaEn}`}>{contenido().nodos.get(declaradaEn)?.titulo}</a></p>
  <h1 class="titulo-arista"><a href={`/nodos/${a.desde}`}>{desde.titulo}</a> <span class="tipo">{ETIQUETA_ARISTA[a.tipo]}</span> <a href={`/nodos/${a.hacia}`}>{hacia.titulo}</a></h1>
  <p><span class={`badge badge-${a.consenso}`}>{ETIQUETA_CONSENSO[a.consenso]}</span> <span class="meta">{periodoTexto(desde.periodo)} → {periodoTexto(hacia.periodo)}</span></p>
  <div class="prosa entradilla" set:html={renderInline(a.nota)} />

  {escuelasImplicadas.length > 0 && (
    <section>
      <h2>Quién la sostiene y quién la niega</h2>
      <div class="rejilla-2">
        <div>
          <h3 class="a-favor">Sostenida por</h3>
          {(a.sostenida_por ?? []).length === 0 ? <p class="meta">Ninguna escuela la reclama como propia; consenso {ETIQUETA_CONSENSO[a.consenso]}.</p> : (a.sostenida_por ?? []).map((e) => (
            <div class="tarjeta">
              <h4><a href={`/escuelas#${e}`}>{nombre(e)}</a></h4>
              {[desde, hacia].map((n) => { const it = interpretacionesDe(n, e); return it ? <p class="meta"><strong>En «{n.titulo}»</strong> ({ETIQUETA_PESO[it.peso_academico]}): <span set:html={renderInline(it.mecanismo)} /></p> : null; })}
            </div>
          ))}
        </div>
        <div>
          <h3 class="en-contra">Negada por</h3>
          {(a.negada_por ?? []).length === 0 ? <p class="meta">Ninguna escuela la niega explícitamente.</p> : (a.negada_por ?? []).map((e) => (
            <div class="tarjeta">
              <h4><a href={`/escuelas#${e}`}>{nombre(e)}</a></h4>
              {[desde, hacia].map((n) => { const it = interpretacionesDe(n, e); return it ? <p class="meta"><strong>En «{n.titulo}»</strong> ({ETIQUETA_PESO[it.peso_academico]}): <span set:html={renderInline(it.mecanismo)} /></p> : null; })}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section>
    <h2>Series que cada extremo invoca</h2>
    <div class="rejilla-2">
      {[desde, hacia].map((n) => (
        <div>
          <h3>{n.titulo}</h3>
          {seriesDe(n).length === 0 ? <p class="meta">Sin series asociadas todavía.</p> : <ul class="lista-limpia">{seriesDe(n).map(({ ref, serie }) => <li><a href={`/datos#serie-${ref.serie}`}>{ref.serie}</a> {serie && <span class={`badge ${serie.nivel_evidencia === "estimacion_conjetural" ? "badge-conjetural" : serie.nivel_evidencia === "estadistica_oficial" ? "badge-alto" : "badge-medio"}`}>{ETIQUETA_EVIDENCIA[serie.nivel_evidencia]}</span>}{ref.nota && <p class="meta" set:html={renderInline(ref.nota)} />}</li>)}</ul>}
        </div>
      ))}
    </div>
  </section>

  {fuentes.length > 0 && (
    <section>
      <h2>Fuentes de la arista</h2>
      <ul class="lista-limpia">{fuentes.map((f) => <li><a class="cita" href={`/fuentes#${f.id}`}>{f.id}</a> {f.autores.join("; ")} ({f.anio ?? "s.f."}). <em>{f.titulo}</em>. {!f.verified && <span class="badge badge-disputado">sin verificar</span>}</li>)}</ul>
    </section>
  )}
  <p><a href="/aristas">← Todas las aristas</a> · <a href="/grafo">Ver en el grafo</a></p>
</Base>
<style>
  .titulo-arista { font-size: clamp(1.5rem, 3vw, 2.3rem); }
  .titulo-arista a { color: var(--tinta); text-decoration: none; }
  .titulo-arista .tipo { display: block; font-family: var(--sans); font-size: 1rem; color: var(--tinta-3); margin: 0.2rem 0; }
  .a-favor { color: #24513d; }
  .en-contra { color: var(--acento); }
  .tarjeta h4 { margin: 0 0 0.4rem; font-size: 1.05rem; }
</style>
