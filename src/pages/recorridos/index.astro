---
import Base from "../../layouts/Base.astro";
import { colorUnidad, contenido, recorridosOrdenados } from "../../lib/contenido.ts";
const recorridos = recorridosOrdenados();
const unidad = (id: string) => contenido().unidades.get(id);
---
<Base titulo="Recorridos">
  <p class="sobretitulo">Modo recorrido</p>
  <h1>Ocho recorridos, uno por unidad</h1>
  <p class="entradilla">Cada recorrido encadena tres nodos con una pregunta de apertura y termina en la Vista Debate. No es un relato lineal: es una secuencia de preguntas para usar en clase.</p>
  <ol class="lista-limpia tarjetas">
    {recorridos.map((r) => {
      const u = unidad(r.unidad);
      return (
        <li class="tarjeta" style={`border-left: 4px solid ${colorUnidad(u?.numero)}`}>
          <p class="sobretitulo">Unidad {u?.numero}</p>
          <h3><a href={`/recorridos/${r.id}`}>{r.titulo}</a></h3>
          <p class="meta">{r.pregunta_de_apertura}</p>
          <p class="meta">{r.pasos.length} pasos · cierre en la Vista Debate de «{contenido().nodos.get(r.cierre.nodo)?.titulo}»</p>
        </li>
      );
    })}
  </ol>
</Base>
