---
import Base from "../layouts/Base.astro";
---
<Base titulo="Buscar">
  <p class="sobretitulo">Búsqueda</p>
  <h1>Buscar</h1>
  <p class="entradilla">Títulos, resúmenes, escuelas, fuentes, glosario y recorridos. Índice estático generado en el build; sin servidor.</p>
  <form class="buscador" data-buscador role="search">
    <input type="search" name="q" placeholder="ej. patrón oro, Pomeranz, refutar…" aria-label="Texto a buscar" autofocus />
  </form>
  <p class="meta" data-estado>Escribí al menos dos letras.</p>
  <ul class="lista-limpia resultados" data-resultados></ul>
</Base>
<style>
  .buscador input { font: inherit; font-size: 1.1rem; width: 100%; max-width: 40rem; padding: 0.7rem 1rem; border: 1px solid var(--linea); border-radius: 999px; background: white; }
  .resultados li { padding: 0.7rem 0; border-bottom: 1px solid var(--linea); }
  .resultados a { font-family: var(--serif); font-size: 1.1rem; text-decoration: none; color: var(--tinta); }
  .resultados a:hover { color: var(--acento); }
  .resultados mark { background: var(--aviso-fondo); }
</style>
<script>
  interface Entrada { tipo: string; titulo: string; url: string; texto: string }
  const normalizar = (t: string): string => t.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
  const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
  const form = document.querySelector<HTMLFormElement>("[data-buscador]")!;
  const input = form.querySelector<HTMLInputElement>("input")!;
  const lista = document.querySelector<HTMLElement>("[data-resultados]")!;
  const estado = document.querySelector<HTMLElement>("[data-estado]")!;
  let indice: Entrada[] | null = null;
  const q0 = new URLSearchParams(location.search).get("q");
  if (q0) input.value = q0;
  form.addEventListener("submit", (e) => e.preventDefault());
  async function buscar(): Promise<void> {
    const q = normalizar(input.value.trim());
    if (q.length < 2) { lista.innerHTML = ""; estado.textContent = "Escribí al menos dos letras."; return; }
    if (!indice) indice = (await (await fetch(`${BASE}/buscar.json`)).json()) as Entrada[];
    const palabras = q.split(/\s+/);
    const hits = indice.map((e) => { const h = normalizar(`${e.titulo} ${e.texto}`); const puntos = palabras.reduce((acc, p) => acc + (normalizar(e.titulo).includes(p) ? 3 : 0) + (h.includes(p) ? 1 : 0), 0); return { e, puntos }; })
      .filter((x) => x.puntos > 0 && palabras.every((p) => normalizar(`${x.e.titulo} ${x.e.texto}`).includes(p))).sort((a, b) => b.puntos - a.puntos).slice(0, 40);
    estado.textContent = `${hits.length} resultado${hits.length === 1 ? "" : "s"}`;
    lista.innerHTML = hits.map(({ e }) => `<li><span class="chip">${e.tipo}</span> <a href="${BASE}${e.url}">${e.titulo}</a><br><span class="meta">${e.texto.replace(/\[@[^\]]+\]/g, "").slice(0, 160)}…</span></li>`).join("");
  }
  input.addEventListener("input", () => { void buscar(); });
  void buscar();
</script>
