---
import { enlace } from "../lib/rutas.ts";
import "../styles/global.css";
import { escuelasOrdenadas, proyecto } from "../lib/contenido.ts";
const escuelas = escuelasOrdenadas();
const p = proyecto();
const autorMostrado = p.autor.seudonimo !== undefined ? `${p.autor.nombre} (${p.autor.seudonimo})` : p.autor.nombre;
const canonica = /^https?:/.test(p.sitio) ? new URL(Astro.url.pathname, p.sitio).href : undefined;
const datosEstructurados = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: `${p.titulo}. ${p.subtitulo}`,
  description: p.descripcion,
  inLanguage: "es",
  author: { "@type": "Person", name: p.autor.nombre, ...(p.autor.orcid !== undefined ? { identifier: p.autor.orcid } : {}), ...(p.autor.afiliacion !== undefined ? { affiliation: p.autor.afiliacion } : {}) },
  copyrightHolder: { "@type": "Person", name: p.autor.nombre },
  copyrightYear: p.anio,
  license: p.licencia_contenido.url,
  ...(/^https?:/.test(p.sitio) ? { url: p.sitio } : {}),
  ...(/^https?:/.test(p.repositorio) ? { codeRepository: p.repositorio } : {}),
};
interface Props {
  titulo: string;
  descripcion?: string;
  ancho?: "normal" | "completo";
}
const { titulo, descripcion = "Plataforma para explorar la transformación de la economía mundial a través del tiempo, el espacio, los datos y las interpretaciones en disputa.", ancho = "normal" } = Astro.props;
const ruta = Astro.url.pathname;
// Seis destinos principales; el resto vive en el menú «Más» para que el encabezado respire.
const enlaces = [
  { href: "/tiempo", texto: "Tiempo" },
  { href: "/espacio", texto: "Espacio" },
  { href: "/datos", texto: "Datos" },
  { href: "/grafo", texto: "Grafo" },
  { href: "/nodos", texto: "Nodos" },
  { href: "/escuelas", texto: "Escuelas" },
];
const secundarios = [
  { href: "/recorridos", texto: "Recorridos guiados" },
  { href: "/aristas", texto: "Relaciones causales" },
  { href: "/glosario", texto: "Glosario" },
  { href: "/fuentes", texto: "Fuentes" },
  { href: "/creditos", texto: "Créditos" },
];
const activo = (href: string): "page" | undefined => { const h = enlace(href); return ruta === h || (href !== "/" && ruta.startsWith(h + "/")) ? "page" : undefined; };
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · Historia económica mundial</title>
    <meta name="description" content={descripcion} />
    <meta name="author" content={p.autor.nombre} />
    <meta name="copyright" content={`© ${p.anio} ${autorMostrado}. Contenido bajo ${p.licencia_contenido.spdx}; código bajo ${p.licencia_codigo.spdx}.`} />
    <meta name="generator" content={Astro.generator} />
    <link rel="license" href={p.licencia_contenido.url} />
    <link rel="author" href={enlace("/creditos")} />
    {canonica && <link rel="canonical" href={canonica} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={p.titulo} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content="es" />
    {canonica && <meta property="og:url" content={canonica} />}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(datosEstructurados)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="cabecera">
      <div class="contenedor fila">
        <a class="marca" href={enlace("/")}>Historia económica mundial</a>

        <nav class="nav" aria-label="Principal">
          {enlaces.map((e) => <a href={enlace(e.href)} aria-current={activo(e.href)}>{e.texto}</a>)}
          <details class="mas">
            <summary aria-label="Más secciones">Más</summary>
            <div class="desplegable">
              {secundarios.map((e) => <a href={enlace(e.href)} aria-current={activo(e.href)}>{e.texto}</a>)}
            </div>
          </details>
        </nav>

        <div class="herramientas">
          <a class="buscar" href={enlace("/buscar")} aria-label="Buscar" title="Buscar">
            <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2" /><line x1="12.8" y1="12.8" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          </a>
          <label class="selector-escuela" title="Reencuadra el sitio entero según una escuela interpretativa">
            <span class="etiqueta-sel">Escuela</span>
            <select id="selector-escuela" aria-label="Escuela interpretativa activa">
              <option value="">todas</option>
              {escuelas.map((e) => <option value={e.id}>{e.nombre}</option>)}
            </select>
          </label>
        </div>
      </div>
    </header>
    <main>
      <div class={ancho === "completo" ? "ancho-completo" : "contenedor"}>
        <slot />
      </div>
    </main>
    <div class="banda-escuela" data-banda-escuela hidden>
      <div class="contenedor">Leyendo según la escuela <strong data-banda-nombre></strong>: se resaltan sus interpretaciones y las aristas que sostiene; se atenúan las que niega. <button type="button" data-quitar-escuela>Quitar</button></div>
    </div>
    <footer class="pie">
      <div class="contenedor">
        <p class="autoria-pie">© {p.anio} <strong>{autorMostrado}</strong> · Contenido bajo <a href={p.licencia_contenido.url}>{p.licencia_contenido.spdx}</a>, código bajo <a href={p.licencia_codigo.url}>{p.licencia_codigo.spdx}</a> · <a href={enlace("/creditos")}>Créditos y cómo citar</a>{/^https?:/.test(p.repositorio) ? <> · <a href={p.repositorio}>Repositorio</a></> : null}</p>
        <p>Toda cifra es rastreable a su fuente. Toda serie anterior a 1820 es una reconstrucción, no una medición, y la interfaz lo señala en cada gráfico.</p>
        <p>Contenido versionado en Git. Sin cuentas, sin comentarios, sin texto generado publicado como contenido.</p>
      </div>
    </footer>
    <script>
      const CLAVE = "escuela-activa";
      const selector = document.querySelector<HTMLSelectElement>("#selector-escuela");
      const banda = document.querySelector<HTMLElement>("[data-banda-escuela]");
      const bandaNombre = document.querySelector<HTMLElement>("[data-banda-nombre]");
      const lista = (el: HTMLElement | SVGElement, attr: string): string[] => (el.getAttribute(attr) ?? "").split(" ").filter(Boolean);

      function aplicar(id: string): void {
        document.documentElement.dataset.escuela = id;
        document.querySelectorAll<HTMLElement>("[data-escuela]").forEach((el) => {
          const propia = el.dataset.escuela === id;
          el.classList.toggle("escuela-activa", id !== "" && propia);
          el.classList.toggle("escuela-inactiva", id !== "" && !propia);
        });
        document.querySelectorAll<HTMLElement>("[data-sostenida], [data-negada]").forEach((el) => {
          el.classList.toggle("sostenida-activa", id !== "" && lista(el, "data-sostenida").includes(id));
          el.classList.toggle("negada-activa", id !== "" && lista(el, "data-negada").includes(id));
        });
        document.querySelectorAll<HTMLElement | SVGElement>("[data-escuelas]").forEach((el) => {
          el.classList.toggle("sin-escuela-activa", id !== "" && !lista(el, "data-escuelas").includes(id));
        });
        if (banda && bandaNombre && selector) {
          banda.hidden = id === "";
          bandaNombre.textContent = selector.selectedOptions[0]?.textContent ?? id;
        }
        document.dispatchEvent(new CustomEvent("escuela-cambiada", { detail: id }));
      }

      let inicial = "";
      try { inicial = localStorage.getItem(CLAVE) ?? ""; } catch { inicial = ""; }
      if (selector) {
        if ([...selector.options].some((o) => o.value === inicial)) selector.value = inicial; else inicial = "";
        selector.addEventListener("change", () => {
          try { localStorage.setItem(CLAVE, selector.value); } catch { /* sin almacenamiento */ }
          aplicar(selector.value);
        });
      }
      document.querySelectorAll<HTMLElement>("[data-activar-escuela]").forEach((b) => {
        b.addEventListener("click", () => {
          if (!selector) return;
          selector.value = b.dataset.activarEscuela ?? "";
          selector.dispatchEvent(new Event("change"));
        });
      });
      document.querySelector("[data-quitar-escuela]")?.addEventListener("click", () => {
        if (!selector) return;
        selector.value = "";
        selector.dispatchEvent(new Event("change"));
      });
      aplicar(inicial);
    </script>
  </body>
</html>
